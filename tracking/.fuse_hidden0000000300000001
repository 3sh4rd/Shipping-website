  <script src="/config.js?v=3"></script>
  <script src="/api.js?v=3"></script>
  <script src="/chatbot.js?v=3"></script>
  <script>
    const toggle = document.getElementById('navToggle');
    const links = document.getElementById('navLinks');
    toggle.addEventListener('click', () => links.classList.toggle('open'));

    const form = document.getElementById('trackForm');
    const input = document.getElementById('trackInput');
    const result = document.getElementById('trackResult');

    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

    function loading(tn) {
      result.innerHTML = `<div class="track-loading">🔎 Looking up <b>${esc(tn)}</b>…</div>`;
    }

    function notConfigured(tn) {
      result.innerHTML = `
        <div class="track-card-panel notice">
          <h3>⚙️ Tracking backend not connected yet</h3>
          <p>The tracking UI is ready. To make it live, set <code>apiBaseUrl</code> in <code>config.js</code> to your API. This page will call:</p>
          <pre>GET {apiBaseUrl}/api/tracking/${esc(tn || ':trackingNumber')}</pre>
          <p>Expected response:</p>
          <pre>{
  "trackingNumber": "${esc(tn || 'GOFA-284419')}",
  "status": "In Transit",
  "origin": "Miami, FL",
  "destination": "Nassau, Bahamas",
  "eta": "2 days",
  "events": [
    { "status": "Picked up", "location": "Miami, FL", "timestamp": "2026-07-24T09:00:00Z", "done": true },
    { "status": "Departed port", "location": "Miami, FL", "timestamp": "2026-07-25T18:00:00Z", "done": true },
    { "status": "In transit", "location": "At sea", "timestamp": "2026-07-26T08:00:00Z", "done": false }
  ]
}</pre>
          <p class="muted">Need help wiring this up? <a href="/contact/">Contact us</a>.</p>
        </div>`;
    }

    function errorMsg(msg) {
      result.innerHTML = `<div class="track-card-panel error"><h3>❌ ${esc(msg)}</h3><p>Please check the tracking number and try again, or <a href="/contact/">contact us</a>.</p></div>`;
    }

    function render(data) {
      const events = Array.isArray(data.events) ? data.events : [];
      const steps = events.map(ev => `
        <li class="track-step ${ev.done ? 'done' : 'current'}">
          <span class="dot"></span>
          <div>
            <strong>${esc(ev.status)}</strong>
            <small>${esc(ev.location || '')}${ev.timestamp ? ' · ' + new Date(ev.timestamp).toLocaleString() : ''}</small>
          </div>
        </li>`).join('');

      result.innerHTML = `
        <div class="track-card-panel">
          <div class="track-summary">
            <div>
              <small>Tracking number</small>
              <h3>${esc(data.trackingNumber || '')}</h3>
            </div>
            <span class="track-badge">${esc(data.status || 'Unknown')}</span>
          </div>
          <div class="track-route">
            <div><small>From</small><strong>${esc(data.origin || '-')}</strong></div>
            <div class="track-arrow">→</div>
            <div><small>To</small><strong>${esc(data.destination || '-')}</strong></div>
            <div><small>ETA</small><strong>${esc(data.eta || '-')}</strong></div>
          </div>
          ${steps ? `<ul class="track-timeline">${steps}</ul>` : '<p class="muted">No status events available yet.</p>'}
        </div>`;
    }

    async function track(tn) {
      if (!tn) { input.focus(); return; }
      loading(tn);
      try {
        const data = await GofaAPI.track(tn);
        render(data);
      } catch (err) {
        if (err.code === 'BACKEND_NOT_CONFIGURED') return notConfigured(tn);
        errorMsg(err.message || 'Could not fetch tracking info.');
      }
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); track(input.value.trim()); });

    // Auto-track if arriving from the homepage hero card with ?tn=
    const params = new URLSearchParams(location.search);
    const initial = params.get('tn');
    if (initial) { input.value = initial; track(initial); }
  </script>
</body>
