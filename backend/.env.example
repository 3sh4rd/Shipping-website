# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file (it is gitignored).

# Port the server listens on (Render sets this automatically)
PORT=4000

# Postgres connection string (get a free one at https://neon.tech)
# Looks like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Secret used to sign login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Admin dashboard credentials
ADMIN_USERNAME=Gofa
ADMIN_PASSWORD=Raelynn23$

# Comma-separated list of allowed website origins (CORS).
# Add your live site URL here. "*" allows any origin (fine while testing).
ALLOWED_ORIGINS=*

# ---- AI Quote (Google Gemini) ----
# Free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: model + Bahamas customs fee rules (defaults shown)
GEMINI_MODEL=gemini-2.0-flash
VAT_RATE=0.10
PROCESSING_RATE=0.01
PROC_MIN=10
PROC_MAX=750
ENV_LEVY=0

# ---- Membership billing ----
# PayPal (from developer.paypal.com). Set PAYPAL_ENV=live for real payments.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
# Monthly plan prices (keep in sync with config.js billing.plans)
PRICE_PLUS=19.99
PRICE_BUSINESS=49.99
PRICE_FAMILY=29.99
PLAN_DAYS=30
